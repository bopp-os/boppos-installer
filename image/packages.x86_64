# Live system
base
linux
linux-firmware
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
sudo
zram-generator
# Network (the installer's network page uses NetworkManager through libnm)
networkmanager
wpa_supplicant
# The installer session: sway as a kiosk, squeekboard as the on-screen keyboard (touch-only handhelds)
sway
squeekboard
dbus
mesa
adwaita-fonts
noto-fonts
# Installer (bopp-os repo); fisherman pulls podman, skopeo and the disk tools; boppos-artwork has the BoppOS icons
boppos-artwork
# The boot splash: plymouth and the BoppOS theme (boppos-boot-theme, from the boppos-tools release)
plymouth
boppos-boot-theme
boppos-bootc-installer
boppos-fisherman
efibootmgr
# grub-install for ostree installs (fisherman's grub-external bootloader); the image brings its own grub-mkconfig
grub
lvm2
# systemd-cryptenroll loads these to enroll the TPM2 unlock token during install
tpm2-tss
