#!/bin/bash
# rotate: turn the installer's screen (type it on tty2: Ctrl+Alt+F2). Try "rotate 90", "rotate 270" or "rotate normal"
# if a screen comes up sideways. With no argument it lists the outputs.
uid=$(id -u liveuser)
sock=
for s in /run/user/"$uid"/sway-ipc.*.sock; do [ -S "$s" ] && { sock=$s; break; }; done
[ -n "$sock" ] || { echo "no sway session yet (is the installer on tty1?)"; exit 1; }
export SWAYSOCK=$sock
if [ -z "$1" ]; then swaymsg -t get_outputs | grep -E "^Output|Current mode|Transform"; exit; fi
case "$1" in normal | 90 | 180 | 270 | flipped | flipped-90 | flipped-180 | flipped-270) ;; *) echo "usage: rotate [normal|90|180|270]"; exit 2 ;; esac
out=$(swaymsg -t get_outputs | awk '/^Output / {print $2; exit}')
swaymsg output "$out" transform "$1" && swaymsg input type:touch map_to_output "$out" >/dev/null && echo "$out -> $1"
